# Copy to .env and edit. NEVER commit .env. All values below are safe placeholders.
APP_ENV=dev
LOG_LEVEL=INFO
DB_PATH=var/qre.sqlite3

# testnet | demo | mainnet  (endpoints derived automatically; override if needed)
BYBIT_ENV=testnet
BYBIT_REST_URL=
BYBIT_WS_URL=
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# Public market data source (no keys). Mainnet by default even when trading env is testnet.
MARKET_DATA_REST_URL=https://api.bybit.com
HTTP_TIMEOUT_S=10
HTTP_MAX_ATTEMPTS=4
HTTP_MIN_INTERVAL_MS=100
KLINE_PAGE_LIMIT=1000

SYMBOLS=BTCUSDT,ETHUSDT
# canonical timeframes: 1m,5m,15m,1h,4h,1d
TIMEFRAMES=15m,1h
STRATEGY_PARAMS_FILE=

# disabled | paper   (demo/live are refused by this build)
EXECUTION_MODE=disabled
LIVE_TRADING_ENABLED=false
SPOT_LIVE_ENABLED=false
DEMO_TRADING_ENABLED=false

RISK_PER_TRADE_PCT=0.5
MAX_OPEN_RISK_PCT=2.5
MAX_LEVERAGE=3
MAX_OPEN_POSITIONS=3
DAILY_LOSS_LIMIT_PCT=2
KILL_SWITCH_DRAWDOWN_PCT=15
HARD_DRAWDOWN_LIMIT_PCT=20

# Regime Engine thresholds (versioned JSON; hash stored with every snapshot)
REGIME_CONFIG_FILE=config/regime_v1.json
# Market monitor runtime (symbols, timeframes, polling, retry, heartbeat)
MONITOR_CONFIG_FILE=config/monitor_v1.json
# Market structure & liquidity (swings, BOS/CHoCH, EQH/EQL)
STRUCTURE_CONFIG_FILE=config/structure_v1.json
# Setup detection (breakout, pullback, sweep reversal, range rejection) - not trading signals
SETUP_CONFIG_FILE=config/setup_v1.json
# Research & backtest (offline; hypothetical test rules, cost ASSUMPTIONS)
RESEARCH_CONFIG_FILE=config/research_v1.json
BACKTEST_CONFIG_FILE=config/backtest_v1.json
# Strategy + Risk offline evaluation (Phase 9; risk limits come from the RISK_* settings above)
STRATEGY_CONFIG_FILE=config/strategy_v1.json
DECISION_RUN_CONFIG_FILE=config/decision_run_v1.json

# none | gemini | claude | openai | ollama  (not used in Phase 0)
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=your_ai_api_key_here
